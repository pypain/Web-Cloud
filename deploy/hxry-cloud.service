[Unit]
Description=Hxry private cloud storage
After=local-fs.target

[Service]
Type=simple
User=hxry-cloud
Group=hxry-cloud
SupplementaryGroups=www-data
ExecStart=/usr/bin/python3 /opt/hxry-cloud-backend/current/server.py
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CLOUD_TOKEN_FILE=/etc/hxry-cloud/backend-token
Environment=CLOUD_DATA=/var/lib/hxry-cloud
Environment=CLOUD_SOCKET=/run/hxry-cloud/backend.sock
Environment=CLOUD_ORIGIN=https://hxry.ru
Environment=CLOUD_QUOTA=21474836480
Environment=CLOUD_MAX_FILE=5368709120
StateDirectory=hxry-cloud
StateDirectoryMode=0700
RuntimeDirectory=hxry-cloud
RuntimeDirectoryMode=0711
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
